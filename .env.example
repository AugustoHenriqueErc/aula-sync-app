# Backend: lê PORT do ambiente do processo; padrão 3000.
# Este arquivo não é carregado automaticamente. Exemplo: PORT=3001 go run ./cmd/api
PORT=3000
# Persistência: cmd/api e cmd/db leem DATABASE_PATH; relativo ao diretório de execução.
# Exemplo em backend/: DATABASE_PATH=aulas-estudo.db go run ./cmd/db migrar
DATABASE_PATH=aulas.db
# Frontend: copiar as variáveis abaixo para frontend/.env.local se necessário.
# O navegador usa /api; o proxy do Vite encaminha ao backend no desenvolvimento.
# Variáveis VITE_ ficam públicas no navegador: nunca colocar segredos aqui.
VITE_API_URL=/api
# Destino do proxy, lido apenas pela configuração do Vite.
API_PROXY_TARGET=http://127.0.0.1:3000

# Login Google (etapa 10). Deixar todos vazios mantém o modo local de estudo.
# Definir TODOS no ambiente do backend; configuração parcial impede a inicialização.
# Não usar VITE_ para essas variáveis. O backend não carrega .env automaticamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APP_URL=
# Exemplo de URLs para Vite em localhost:5173:
# APP_URL=http://localhost:5173
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Tokens e sessões permanecem somente em memória; reiniciar exige novo login.
