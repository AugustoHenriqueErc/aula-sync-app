# Backend: lê PORT do ambiente do processo; padrão 3000.
# Este arquivo não é carregado automaticamente. Exemplo: PORT=3001 go run ./cmd/api
PORT=3000
# Frontend: copiar as variáveis abaixo para frontend/.env.local se necessário.
# O navegador usa /api; o proxy do Vite encaminha ao backend no desenvolvimento.
# Variáveis VITE_ ficam públicas no navegador: nunca colocar segredos aqui.
VITE_API_URL=/api
# Destino do proxy, lido apenas pela configuração do Vite.
API_PROXY_TARGET=http://127.0.0.1:3000
